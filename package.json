{
  "name": "kazi-merge",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "build": "npm run build --workspace @kazi-merge/web && npm run build --workspace @kazi-merge/api",
    "dev:web": "npm run dev --workspace @kazi-merge/web",
    "dev:api": "npm run dev --workspace @kazi-merge/api",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "benchmark:dashboard": "tsx scripts/dashboard-benchmark.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"*.{json,mjs}\"",
    "lint": "eslint \"apps/**/*.{ts,tsx}\"",
    "typecheck": "npm run typecheck --workspace @kazi-merge/web && npm run typecheck --workspace @kazi-merge/api",
    "test": "npm run test --workspace @kazi-merge/api"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "prisma": "6.17.1",
    "tsx": "4.20.6",
    "typescript-eslint": "8.46.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
